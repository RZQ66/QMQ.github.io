<div class="search-overlay" data-search-overlay aria-hidden="true">
  <button class="search-backdrop" type="button" aria-label="关闭搜索" data-search-close></button>
  <section class="search-panel" role="dialog" aria-modal="true" aria-labelledby="search-title">
    <button class="search-close" type="button" aria-label="关闭搜索" data-search-close>×</button>
    <h2 id="search-title">搜索</h2>
    <input id="site-search-input" type="search" placeholder="搜索文章..." autocomplete="off" data-search-input>
    <div class="search-hint">Ctrl / Cmd + K 打开，Esc 关闭</div>
    <div class="search-results" data-search-results></div>
  </section>
</div>
