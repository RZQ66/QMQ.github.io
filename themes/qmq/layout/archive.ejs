<%- partial('_partial/page-hero', { pageKey: 'archives' }) %>
<section class="archive-page">
  <% const posts = page.posts || site.posts.sort('-date'); %>
  <% posts.each(function(post) { %>
    <a class="archive-item reveal" href="<%- url_for(post.path) %>">
      <time><%= date(post.date, 'YYYY.MM.DD') %></time>
      <span><%= post.title %></span>
    </a>
  <% }) %>
</section>
