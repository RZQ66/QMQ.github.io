<section class="home-hero" data-hero>
  <div class="hero-shade"></div>
  <div class="hero-inner">
    <h1 class="stagger-text" data-stagger><%= theme.hero.title %></h1>
    <p class="stagger-text hero-subtitle" data-stagger><%= theme.hero.subtitle %></p>
  </div>
</section>

<section id="posts" class="post-list-section">
  <div class="post-list">
    <% page.posts.each(function(post, i) { %>
      <%- partial('_partial/post-card', { post, index: i }) %>
    <% }) %>
  </div>
  <% if (page.total > 1) { %>
    <nav class="pagination"><%- paginator() %></nav>
  <% } %>
</section>
